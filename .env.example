# ==============================================================================
# FraudShield Environment Configuration Template (.env.example)
# All configuration is injected via environment variables.
# ==============================================================================

# Service & Environment
FRAUDSHIELD_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
METRICS_WINDOW_SIZE=1000

# Administrative Security (Required in production for /admin endpoints)
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=dev_admin_secret_key_change_in_prod

# Scoring Thresholds
DECISION_THRESHOLD=0.99
ALERT_THRESHOLD_HIGH=0.70
ALERT_THRESHOLD_MED=0.30
GNN_BLEND_WEIGHT=0.30
BLEND_ALPHA=1.0
BLEND_DECISION_THRESHOLD=0.99

# Feast Feature Store
FEAST_REPO_PATH=feature_repo

# PostgreSQL Persistence & Storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudshield
USE_SQLITE_FALLBACK=true

# MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraudshield-detection
MODEL_NAME=FraudShield-XGBoost
MODEL_VERSION=1
MODEL_LOCAL_PATH=models/xgboost_model.json
PREPROCESSOR_LOCAL_PATH=models/xgboost_preprocessor.joblib

# Kafka Streaming Pipeline
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_SCORES=scores
KAFKA_TOPIC_DEAD_LETTER=transactions.dlq
KAFKA_CONSUMER_GROUP=fraudshield-scoring-group

# Data Paths
DATA_RAW_PATH=data/raw/PS_20174392719_1491204439457_log.csv
TRAIN_FEATURES_PATH=data/processed/train_features.parquet
VAL_FEATURES_PATH=data/processed/val_features.parquet
TEST_FEATURES_PATH=data/processed/test_features.parquet
