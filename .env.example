# FraudShield Environment Configuration Template
FRAUDSHIELD_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_SCORES=scores
KAFKA_TOPIC_DEAD_LETTER=transactions-dlq
KAFKA_CONSUMER_GROUP=fraudshield-scoring-group

# Redis (Feast Online Store)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudshield

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraudshield-detection

# Scoring Thresholds
ALERT_THRESHOLD_HIGH=0.7
ALERT_THRESHOLD_MED=0.3
GNN_BLEND_WEIGHT=0.3
